{
  "name": "riml-work",
  "private": true,
  "description": "riml (Daiki Takahashi) のポートフォリオ。riml-ds のデザインシステムに乗る",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync:ds": "bun run scripts/sync-design-system.ts",
    "dev": "bun run sync:ds && next dev",
    "build": "bun run sync:ds && next build",
    "serve": "bunx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --ignore-pattern 'vendor/**'",
    "lint:fix": "oxlint --type-aware --fix --ignore-pattern 'vendor/**'",
    "lint:css": "stylelint 'src/**/*.css'",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run fmt:check && bun run lint && bun run lint:css && bun run typecheck",
    "test": "bun test src",
    "storybook": "bun run sync:ds && storybook dev -p 6006",
    "storybook:build": "bun run sync:ds && storybook build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26"
  },
  "packageManager": "bun@1.4.0"
}
