{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "experimentalOperatorPosition": "start",
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/.next/**",
    "**/storybook-static/**",
    "vendor/**",
    ".agents/skills/**",
    ".claude/skills/**",
    "skills-lock.json",
    "src/styles/generated/**",
    "public/**",
    "/README.md",
    "/DESIGN.md",
    "/CLAUDE.md",
    "/AGENTS.md",
    "docs/**"
  ]
}
